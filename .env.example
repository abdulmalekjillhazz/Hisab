# Copy to .env.local and replace placeholders. Never commit real secrets.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-at-least-32-random-bytes
MOBILE_JWT_SECRET=use-a-different-random-secret-of-32-bytes-or-more
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
SUPER_ADMIN_EMAILS=admin@example.com
CAPACITOR_SERVER_URL=https://your-deployed-app.vercel.app
